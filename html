
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TopSpot Soccer Academy</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }
        :root {
            --red: #e50914;
            --dark-red: #a80000;
            --black: #111111;
            --gray: #1f1f1f;
            --light-gray: #f4f4f4;
            --white: #ffffff;
        }
        body {
            background: var(--light-gray);
            color: var(--black);
        }
        /* HEADER */
        header {
            background: var(--black);
            color: var(--white);
            padding: 20px 7%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }
        .logo {
            font-size: 27px;
            font-weight: bold;
            color: var(--red);
        }
        .logo span {
            color: var(--white);
        }
        nav {
            display: flex;
            align-items: center;
            gap: 25px;
        }
        nav a {
            color: var(--white);
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }
        nav a:hover {
            color: var(--red);
        }
        .register-btn {
            background: var(--red);
            color: white;
            padding: 12px 20px;
            border-radius: 5px;
            text-decoration: none;
            font-weight: bold;
            border: none;
            cursor: pointer;
        }
        .register-btn:hover {
            background: var(--dark-red);
        }
        /* HERO SECTION */
        .hero {
            background: linear-gradient(135deg, #111111, #300000);
            color: white;
            min-height: 480px;
            display: flex;
            align-items: center;
            padding: 70px 8%;
        }
        .hero-content {
            max-width: 700px;
        }
        .hero h1 {
            font-size: 60px;
            line-height: 1.1;
            margin-bottom: 20px;
        }
        .hero h1 span {
            color: var(--red);
        }
        .hero h2 {
            font-size: 24px;
            margin-bottom: 20px;
            color: #eeeeee;
        }
        .hero p {
            font-size: 18px;
            line-height: 1.7;
            margin-bottom: 30px;
            color: #cccccc;
        }
        .hero-buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }
        .btn {
            display: inline-block;
            padding: 14px 28px;
            border-radius: 5px;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }
        .btn-red {
            background: var(--red);
            color: white;
        }
        .btn-red:hover {
            background: var(--dark-red);
        }
        .btn-outline {
            border: 2px solid white;
            color: white;
        }
        .btn-outline:hover {
            background: white;
            color: black;
        }
        /* FEATURES */
        .features {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            background: white;
            padding: 30px 7%;
            gap: 20px;
            text-align: center;
        }
        .feature {
            padding: 15px;
            border-right: 1px solid #dddddd;
        }
        .feature:last-child {
            border-right: none;
        }
        .feature h3 {
            color: var(--red);
            margin-bottom: 10px;
        }
        .feature p {
            color: #555555;
            line-height: 1.5;
        }
        /* GENERAL SECTION */
        section {
            padding: 70px 8%;
        }
        .section-title {
            text-align: center;
            margin-bottom: 15px;
            font-size: 36px;
        }
        .section-title span {
            color: var(--red);
        }
        .section-description {
            text-align: center;
            color: #555555;
            margin-bottom: 45px;
            font-size: 17px;
            line-height: 1.6;
        }
        /* ABOUT */
        .about {
            background: white;
        }
        .about-content {
            max-width: 900px;
            margin: auto;
            text-align: center;
        }
        .about-content p {
            font-size: 17px;
            line-height: 1.8;
            color: #444444;
            margin-bottom: 20px;
        }
        /* PROGRAMS */
        .programs {
            background: #f4f4f4;
        }
        .program-cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 25px;
        }
        .program-card {
            background: white;
            border-radius: 8px;
            overflow: hidden;
            border-bottom: 5px solid var(--red);
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            transition: 0.3s;
        }
        .program-card:hover {
            transform: translateY(-5px);
        }
        .program-placeholder {
            height: 140px;
            background: linear-gradient(135deg, #111111, #450000);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--red);
            font-size: 24px;
            font-weight: bold;
        }
        .program-card-content {
            padding: 25px;
        }
        .program-card h3 {
            color: var(--red);
            margin-bottom: 15px;
        }
        .program-card p {
            line-height: 1.6;
            color: #555555;
        }
        /* VALUES */
        .values {
            background: var(--black);
            color: white;
        }
        .values .section-description {
            color: #cccccc;
        }
        .values-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }
        .value-card {
            background: #222222;
            padding: 30px;
            border-radius: 8px;
            border-left: 4px solid var(--red);
        }
        .value-card h3 {
            color: var(--red);
            margin-bottom: 15px;
        }
        .value-card p {
            line-height: 1.7;
            color: #dddddd;
        }
        /* REGISTRATION */
        .registration {
            background: white;
        }
        .registration-form {
            max-width: 700px;
            margin: auto;
            background: #f5f5f5;
            padding: 35px;
            border-radius: 10px;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
        }
        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 13px;
            border: 1px solid #cccccc;
            border-radius: 5px;
            font-size: 16px;
        }
        .form-group textarea {
            resize: vertical;
        }
        .submit-btn {
            width: 100%;
            padding: 15px;
            background: var(--red);
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 17px;
            font-weight: bold;
            cursor: pointer;
        }
        .submit-btn:hover {
            background: var(--dark-red);
        }
        #formMessage {
            margin-top: 15px;
            text-align: center;
            font-weight: bold;
        }
        /* CONTACT */
        .contact {
            background: #1a1a1a;
            color: white;
            text-align: center;
        }
        .contact .section-description {
            color: #cccccc;
        }
        .contact-details {
            line-height: 2.2;
            font-size: 17px;
        }
        .contact-details a {
            color: var(--red);
            text-decoration: none;
        }
        /* FOOTER */
        footer {
            background: #000000;
            color: #aaaaaa;
            text-align: center;
            padding: 25px;
        }
        footer span {
            color: var(--red);
        }
        /* RESPONSIVE DESIGN */
        @media (max-width: 1000px) {
            .program-cards {
                grid-template-columns: repeat(2, 1fr);
            }
            .features {
                grid-template-columns: repeat(2, 1fr);
            }
            .values-grid {
                grid-template-columns: 1fr;
            }
        }
        @media (max-width: 700px) {
            header {
                flex-direction: column;
                gap: 20px;
            }
            nav {
                flex-wrap: wrap;
                justify-content: center;
                gap: 15px;
            }
            nav a {
                font-size: 14px;
            }
            .hero h1 {
                font-size: 40px;
            }
            .hero h2 {
                font-size: 20px;
            }
            .program-cards {
                grid-template-columns: 1fr;
            }
            .features {
                grid-template-columns: 1fr;
            }
            .feature {
                border-right: none;
                border-bottom: 1px solid #dddddd;
            }
            .section-title {
                font-size: 28px;
            }
            .registration-form {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <!-- HEADER -->
    <header>
        <div class="logo">
            TOPSPOT <span>SOCCER ACADEMY</span>
        </div>
        <nav>
            <a href="#home">Home</a>
            <a href="#about">About Us</a>
            <a href="#programs">Programs</a>
            <a href="#values">Our Values</a>
            <a href="#contact">Contact</a>
            <a href="#registration" class="register-btn">
                Register Player
            </a>
        </nav>
    </header>
    <!-- HERO SECTION -->
    <section class="hero" id="home">
        <div class="hero-content">
            <h1>
                TOPSPOT<br>
                <span>SOCCER ACADEMY</span>
            </h1>
            <h2>Developing Talent. Building Champions.</h2>
            <p>
                We are committed to nurturing young football talent through
                professional coaching, discipline, teamwork and character
                development. Our mission is to help every player discover
                their potential and become the best version of themselves.
            </p>
            <div class="hero-buttons">
                <a href="#registration" class="btn btn-red">
                    Join Our Academy
                </a>
                <a href="#about" class="btn btn-outline">
                    Discover Our Academy
                </a>
            </div>
        </div>
    </section>
    <!-- FEATURES -->
    <div class="features">
        <div class="feature">
            <h3>Player Development</h3>
            <p>Technical, tactical and personal growth.</p>
        </div>
        <div class="feature">
            <h3>Competitive Exposure</h3>
            <p>Leagues, tournaments and friendly matches.</p>
        </div>
        <div class="feature">
            <h3>Education & Values</h3>
            <p>Discipline, teamwork and leadership.</p>
        </div>
        <div class="feature">
            <h3>Player Pathways</h3>
            <p>Opportunities to progress to higher levels.</p>
        </div>
    </div>
    <!-- ABOUT US -->
    <section class="about" id="about">
        <h2 class="section-title">
            About <span>TopSpot</span>
        </h2>
        <p class="section-description">
            Building future football stars through passion and dedication.
        </p>
        <div class="about-content">
            <p>
                TopSpot Soccer Academy is dedicated to identifying, nurturing
                and developing young football talent. We provide a structured
                environment where players learn the fundamentals of football,
                develop their technical abilities and grow in confidence.
            </p>
            <p>
                Our approach goes beyond the pitch. We emphasize discipline,
                respect, teamwork, integrity and education to ensure that
                our players develop into responsible individuals and
                successful athletes.
            </p>
        </div>
    </section>
    <!-- TRAINING PROGRAMS -->
    <section class="programs" id="programs">
        <h2 class="section-title">
            Our Training <span>Programs</span>
        </h2>
        <p class="section-description">
            Structured, age-appropriate training designed to develop
            football skills, fitness and game intelligence.
        </p>
        <div class="program-cards">
            <div class="program-card">
                <div class="program-placeholder">
                    U7 – U9
                </div>
                <div class="program-card-content">
                    <h3>Foundation</h3>
                    <p>
                        Introduction to football through fun, coordination,
                        ball mastery and basic technical skills.
                    </p>
                </div>
            </div>
            <div class="program-card">
                <div class="program-placeholder">
                    U10 – U12
                </div>
                <div class="program-card-content">
                    <h3>Development</h3>
                    <p>
                        Building technical abilities, tactical awareness,
                        passing, movement and teamwork.
                    </p>
                </div>
            </div>
            <div class="program-card">
                <div class="program-placeholder">
                    U13 – U15
                </div>
                <div class="program-card-content">
                    <h3>Performance</h3>
                    <p>
                        Advanced technical training, fitness development,
                        tactical understanding and competitive preparation.
                    </p>
                </div>
            </div>
            <div class="program-card">
                <div class="program-placeholder">
                    U16 – U19
                </div>
                <div class="program-card-content">
                    <h3>Elite Pathway</h3>
                    <p>
                        High-performance training, talent identification
                        and preparation for advanced competitive football.
                    </p>

                </div>
            </div>
        </div>
    </section>
    <!-- OUR VALUES -->
    <section class="values" id="values">
        <h2 class="section-title">
            Our <span>Core Values</span>
        </h2>
        <p class="section-description">
            The principles that shape every player at TopSpot.
        </p>
        <div class="values-grid">
            <div class="value-card">
                <h3>Discipline</h3>
                <p>
                    Building commitment, responsibility and respect
                    both on and off the football pitch.
                </p>
            </div>
            <div class="value-card">
                <h3>Teamwork</h3>
                <p>
                    Learning to work together, support teammates
                    and achieve collective success.
                </p>
            </div>
            <div class="value-card">
                <h3>Excellence</h3>
                <p>
                    Encouraging hard work, continuous improvement
                    and the pursuit of personal and team excellence.
                </p>
            </div>
        </div>
    </section>
    <!-- PLAYER REGISTRATION -->
    <section class="registration" id="registration">
        <h2 class="section-title">
            Player <span>Registration</span>
        </h2>
        <p class="section-description">
            Interested in joining TopSpot Soccer Academy?
            Fill in the registration form below.
        </p>
        <form class="registration-form" id="playerForm">
            <div class="form-group">
                <label for="playerName">Player's Full Name</label>
                <input type="text" id="playerName"
                       placeholder="Enter player's full name"
                       required>
            </div>
            <div class="form-group">
                <label for="dob">Date of Birth</label>
                <input type="date" id="dob" required>
            </div>
            <div class="form-group">
                <label for="gender">Gender</label>
                <select id="gender" required>
                    <option value="">Select gender</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
            </div>
            <div class="form-group">
                <label for="program">Preferred Program</label>
                <select id="program" required>
                    <option value="">Select age group</option>
                    <option value="U7-U9">U7 – U9 Foundation</option>
                    <option value="U10-U12">U10 – U12 Development</option>
                    <option value="U13-U15">U13 – U15 Performance</option>
                    <option value="U16-U19">U16 – U19 Elite Pathway</option>
                </select>
            </div>
            <div class="form-group">
                <label for="parentName">Parent / Guardian Name</label>
                <input type="text" id="parentName"
                       placeholder="Enter parent or guardian's name"
                       required>
            </div>
            <div class="form-group">
                <label for="phone">Parent / Guardian Phone Number</label>
                <input type="tel" id="phone"
                       placeholder="e.g. 0712345678"
                       required>
            </div>
            <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email"
                       placeholder="Enter email address">

            </div>
            <div class="form-group">
                <label for="experience">Previous Football Experience</label>
                <textarea id="experience" rows="4"
                          placeholder="Tell us about the player's experience"></textarea>

            </div>
            <button type="submit" class="submit-btn">
                Submit Registration
            </button>
                        <p id="formMessage"></p>
        </form>
    </section>
    <!-- CONTACT -->
    <section class="contact" id="contact">
        <h2 class="section-title">
            Contact <span>Us</span>
        </h2>
        <p class="section-description">
            We would love to hear from you.
        </p>
        <div class="contact-details">
            <p>
                <strong>TopSpot Soccer Academy</strong>
            </p>
            <p>
                Location: [Insert Academy Location]
            </p>
            <p>
                Phone: [Insert Phone Number]
            </p>
            <p>
                Email: [Insert Academy Email]
            </p>
        </div>
    </section>
    <!-- FOOTER -->
    <footer>
        <p>
            &copy; 2026 <span>TopSpot Soccer Academy</span>.
            All Rights Reserved.
        </p>
        <p style="margin-top: 10px;">
            Developing Talent. Building Champions.
        </p>
    </footer>
    <!-- JAVASCRIPT -->
    <script>
        // PLAYER REGISTRATION FORM
        document.getElementById("playerForm")
            .addEventListener("submit", function(event) {
                event.preventDefault();
                const playerName =
                    document.getElementById("playerName").value;
                const message =
                    document.getElementById("formMessage");
                message.style.color = "#e50914";
                message.innerHTML =
                    "Thank you, " + playerName +
                    "! Your registration has been received in this demo.";
                this.reset();
            });
        // SET MAXIMUM DATE OF BIRTH TO TODAY
        document.getElementById("dob").max =
            new Date().toISOString().split("T")[0];
    // SMOOTH PAGE NAVIGATION
    document.querySelectorAll('nav a, .hero-buttons a')
        .forEach(function(link) {
            link.addEventListener("click", function(event) {
                const target = document.querySelector(
                    this.getAttribute("href")
                );
                if (target) {
                    event.preventDefault();
                    target.scrollIntoView({
                        behavior: "smooth"
                    });
                }
            });
        });
    </script>
</body>
</html>

